APP_NAME=Smart Finance API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
BACKEND_PORT=3000

MYSQL_DATABASE=smart_finance
MYSQL_USER=finance
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
DATABASE_URL=mysql+asyncmy://finance:change-me-db-password@mysql:3306/smart_finance

QDRANT_URL=http://qdrant:6333
REDIS_URL=

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=zhipu/glm-4-flash
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=zhipu/embedding-3
EMBEDDING_DIMENSION=1024
RERANK_API_KEY=
RERANK_BASE_URL=
RERANK_MODEL=bge-reranker-v2-m3

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

RAG_TOP_K=10
RAG_RERANK_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
AGENT_MAX_ITERATIONS=8
ANOMALY_STANDARD_DEVIATIONS=2
