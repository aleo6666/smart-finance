# Smart Finance - Local Environment
# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored and never committed.

# MySQL
DB_NAME=smart_finance
DB_USER=finance
DB_PASSWORD=FinancePass2026!
DB_ROOT_PASSWORD=FinanceRoot2026!

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant
VECTOR_DB_URL=http://qdrant:6333

# JWT (leave empty to auto-generate on first start)
JWT_SECRET=

# LM Studio
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_CHAT_MODEL=qwen3.6-35b-a3b
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LM_STUDIO_EMBEDDING_TIMEOUT_MS=10000
LM_STUDIO_CHAT_TIMEOUT_MS=120000
LM_STUDIO_LIST_MODELS_TIMEOUT_MS=5000

# RAG
RAG_ENABLED=true
RAG_COLLECTION=finance_records_nomic_v1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# AI API Keys (not used by default local chain - leave empty)
OPENAI_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
