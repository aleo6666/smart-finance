# Smart Finance - Local Environment
# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored and never committed.

# MySQL
DB_NAME=smart_finance
DB_USER=finance
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-root-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Qdrant
VECTOR_DB_URL=http://qdrant:6333

# JWT (leave empty to auto-generate on first start)
JWT_SECRET=

# LLM Provider (OpenAI 兼容格式，支持 LM Studio / DeepSeek / 其他兼容 API)
LM_STUDIO_BASE_URL=https://api.deepseek.com/v1
LM_STUDIO_API_KEY=your-deepseek-api-key
LM_STUDIO_CHAT_MODEL=deepseek-chat
LM_STUDIO_EMBEDDING_MODEL=deepseek-embed
LM_STUDIO_EMBEDDING_TIMEOUT_MS=30000
LM_STUDIO_CHAT_TIMEOUT_MS=120000
LM_STUDIO_LIST_MODELS_TIMEOUT_MS=10000

# RAG
RAG_ENABLED=true
RAG_COLLECTION=finance_records_deepseek_v1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# 其他 AI API Keys (预留)
OPENAI_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=

# LangGraph agent feature flags (safe defaults: all disabled)
ENABLE_LANGGRAPH_AGENT=false
ENABLE_FOUR_LAYER_MEMORY=false
ENABLE_ADMIN_SQL_AGENT=false
ENABLE_PADDLE_OCR=false
ENABLE_QDRANT_KNOWLEDGE=false
ENABLE_BILL_VECTOR_WRITE=false
LANGGRAPH_ROLLOUT_PERCENT=0

# Agent limits
AGENT_MAX_TOOL_CALLS=5
AGENT_GRAPH_RECURSION_LIMIT=12
AGENT_REQUEST_TIMEOUT_MS=120000
AGENT_NETWORK_RETRY_COUNT=2
AGENT_DATASET_TTL_SECONDS=300
AGENT_CONFIRMATION_TTL_SECONDS=1800

# Four-layer memory
MEMORY_WINDOW_MAX_MESSAGES=10
MEMORY_WINDOW_MAX_TOKENS=4000
MEMORY_SESSION_TTL_SECONDS=1800
MEMORY_SUMMARY_TRIGGER_MESSAGES=12
MEMORY_SUMMARY_RETENTION_DAYS=30

# Read-only administrator SQL connection
ADMIN_SQL_HOST=mysql
ADMIN_SQL_PORT=3306
ADMIN_SQL_DB_NAME=smart_finance
ADMIN_SQL_DB_USER=
ADMIN_SQL_DB_PASSWORD=
ADMIN_SQL_MAX_ROWS=200
ADMIN_SQL_TIMEOUT_MS=3000

# PaddleOCR managed API
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_REQUEST_TIMEOUT_MS=300000
PADDLEOCR_POLL_TIMEOUT_MS=600000
