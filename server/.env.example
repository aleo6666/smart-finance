NODE_ENV=development
PORT=3000
UPLOADS_DIR=./uploads

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_finance
DB_USER=finance
DB_PASSWORD=your-db-password
DB_ROOT_PASSWORD=your-root-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-random-64-char-string-xxxxxxxxxxxxxxxx

# Email verification (personal mailbox SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
# SMTP_PASS is the personal mailbox app authorization code, not the mailbox login password.
SMTP_PASS=replace-with-personal-mailbox-authorization-code
MAIL_FROM=Smart Finance <sender@example.com>
EMAIL_OTP_SECRET=replace-with-random-secret-at-least-32-characters

# WeChat
WECHAT_MINI_APPID=your-mini-appid
WECHAT_MINI_SECRET=your-mini-secret
WECHAT_MP_APPID=your-mp-appid
WECHAT_MP_SECRET=your-mp-secret
WECHAT_SUBSCRIBE_TEMPLATE_ID=your-template-id

# AI
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Vector database
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=finance_records
