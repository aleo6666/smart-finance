# Smart Finance - 生产环境配置
# 复制为 .env.production 并填写真实值。此文件不进 git。

# MySQL
DB_NAME=smart_finance
DB_USER=finance
DB_PASSWORD=<用 openssl rand -base64 24 生成>
DB_ROOT_PASSWORD=<用 openssl rand -base64 24 生成>

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT（用 openssl rand -base64 48 生成）
JWT_SECRET=<生成 64 位随机字符串>

# Qdrant
VECTOR_DB_URL=http://qdrant:6333

# LLM - Chat: DeepSeek（轮换后的新 Key）
LM_STUDIO_BASE_URL=https://api.deepseek.com/v1
LM_STUDIO_API_KEY=<轮换后的 DeepSeek API Key>
LM_STUDIO_CHAT_MODEL=deepseek-v4-pro

# LLM - Embedding: 智谱（轮换后的新 Key）
LM_STUDIO_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LM_STUDIO_EMBEDDING_API_KEY=<轮换后的智谱 API Key>
LM_STUDIO_EMBEDDING_MODEL=embedding-3

# RAG
RAG_ENABLED=true
RAG_COLLECTION=finance_records_prod_v1
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# 微信（不用可留空）
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# 其他
OPENAI_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
